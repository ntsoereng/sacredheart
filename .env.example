# Generate a new value for production; never reuse the development key.
SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ENVIRONMENT=production

# Include every hostname that will serve this application.
ALLOWED_HOSTS=school.example.org,www.school.example.org
CSRF_TRUSTED_ORIGINS=https://school.example.org,https://www.school.example.org

# cPanel MySQL databases and users are usually prefixed with the account name.
DB_NAME=cpaneluser_shhs_db
DB_USER=cpaneluser_shhs_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

# WhiteNoise serves collected static assets from the application directory.
STATIC_URL=/static/
STATIC_ROOT=/home/cpaneluser/apps/sacredheart/staticfiles

# Apache serves uploads directly from this shared public directory.
MEDIA_URL=/media/
MEDIA_ROOT=/home/cpaneluser/public_html/media

# Enable these only when the domain has a working SSL certificate.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_CACHE_LOCATION=/home/cpaneluser/apps/sacredheart-cache
# Leave at 0 unless a known reverse proxy supplies X-Forwarded-For. For one
# trusted proxy directly in front of Passenger, set this to 1.
DJANGO_RATELIMIT_TRUSTED_PROXY_DEPTH=0
DJANGO_LOG_LEVEL=INFO

# SMTP credentials for application confirmation receipts. Use a dedicated
# mailbox or app password; never use a personal mailbox password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.school.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=admissions@school.example.org
EMAIL_HOST_PASSWORD=replace-with-a-mailbox-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Sacred Heart Admissions <admissions@school.example.org>
SERVER_EMAIL=Sacred Heart Website <admissions@school.example.org>

# Alumni profile-update magic links use their own mailbox. The SMTP server,
# port, TLS/SSL, backend, and timeout are inherited from the settings above.
ALUMNI_EMAIL_HOST_USER=alumni@sacredheart.ac.ls
ALUMNI_EMAIL_HOST_PASSWORD=replace-with-the-alumni-mailbox-app-password
ALUMNI_DEFAULT_FROM_EMAIL=Sacred Heart Alumni Association <alumni@sacredheart.ac.ls>
